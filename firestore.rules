rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && adminData().role == 'superadmin';
    }

    function isRepresentanteOf(turmaId) {
      return isSignedIn()
        && adminData().role == 'representante'
        && adminData().turmaId == turmaId;
    }

    function canManage(turmaId) {
      return isSuperAdmin() || isRepresentanteOf(turmaId);
    }

    function isValidActivity(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.type in ['tarefa', 'licao', 'trabalho', 'evento']
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.time == null || (data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && data.turmaId is string && data.turmaId.size() > 0;
    }

    // Documento de permissão de cada usuário autenticado.
    // Criado manualmente pelo Console do Firebase — nunca por escrita do app.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Atividades (tarefas, lições, trabalhos, eventos) de uma turma.
    match /activities/{activityId} {
      allow read: if true;

      allow create: if canManage(request.resource.data.turmaId)
        && isValidActivity(request.resource.data);

      allow update: if canManage(resource.data.turmaId)
        && canManage(request.resource.data.turmaId)
        && isValidActivity(request.resource.data);

      allow delete: if canManage(resource.data.turmaId);
    }
  }
}
